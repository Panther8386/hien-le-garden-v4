{
  "name": "hien-le-garden-v4",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist",
    "build": "node scripts/build-static.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:dist:selftest": "node scripts/check-dist.mjs --self-test",
    "release:artifact": "npm run build && npm run check:dist",
    "check:staging": "node scripts/check-staging-bindings.mjs",
    "probe:selftest": "node scripts/probe-private-urls.mjs --self-test",
    "test": "node scripts/test-with-retry.js",
    "test:once": "vitest run",
    "test:each": "node scripts/test-each.js",
    "deploy": "npm run build && npm run check:dist && wrangler pages deploy dist --project-name=hien-le-garden-v4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@playwright/test": "^1.63.0",
    "ajv": "8.20.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.78.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true
  }
}
