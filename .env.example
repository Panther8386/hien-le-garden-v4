# Environment variables used by Pages Functions (names only — never commit real values).
# Production/Preview: set in Cloudflare dashboard -> Workers & Pages -> hien-le-garden-v4 ->
#   Settings -> Variables and Secrets (or `npx wrangler pages secret put <NAME> --project-name=hien-le-garden-v4`).
#   Changes take effect on the next deployment.
# Local dev: copy the names into .dev.vars (git-ignored) for `npm run dev`; this file itself is not read.
# Bindings DB (D1 hien_le_garden_crm) and RECEIPTS (R2) come from wrangler.toml, not from here.
# See docs/releases/admin-permissions-release-runbook.md section 7 for fail behavior.

# Secret. Brevo transactional email API key (voucher email, customer email). Production (+Preview only with separate DB).
BREVO_API_KEY=
# Secret. Telegram bot token from @BotFather (booking notifications, guest deep links). Production.
TELEGRAM_BOT_TOKEN=
# Secret. Webhook header secret, 1-256 chars of A-Z a-z 0-9 _ -; must equal setWebhook secret_token. Production.
TELEGRAM_WEBHOOK_SECRET=
# Not secret (chat ids), but set via `wrangler pages secret put`: wrangler.toml (pages_build_output_dir) owns plain vars.
# Comma-separated Telegram chat ids allowed to run /start staff_booking_notify (hotel chat). Production.
TELEGRAM_BOOKING_NOTIFY_ALLOWED_CHAT_IDS=
# Public, but set via `wrangler pages secret put` (same reason). Turnstile site key for the feedback form. Production (+Preview if testing there).
TURNSTILE_SITE_KEY=
# Secret. Cloudflare Turnstile secret key (server-side siteverify). Production (+Preview if testing there).
TURNSTILE_SECRET_KEY=
# Not secret, but set via `wrangler pages secret put` (same reason as above), per environment.
# Comma-separated exact ASCII hostnames the siteverify `hostname` must equal (no scheme/port/path/wildcard,
# no empty entries or trailing comma, at least one dot; pages.dev/workers.dev/localhost/trycloudflare.com refused).
# Missing/empty/any invalid entry -> every feedback submission 403, siteverify not called (fail closed).
# Production: "hienlegarden.vn" only (PENDING, not set yet). Never *.pages.dev, never www./hien-le-garden-v4.pages.dev
#   (both 301 to the apex). Preview/staging: "staging.hien-le-garden-v4.pages.dev" only.
# Local .dev.vars with Cloudflare test keys (site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA):
#   siteverify then reports hostname "example.com", so set TURNSTILE_ALLOWED_HOSTNAMES=example.com locally.
#   Never use example.com or the test keys in Production or Preview.
TURNSTILE_ALLOWED_HOSTNAMES=
