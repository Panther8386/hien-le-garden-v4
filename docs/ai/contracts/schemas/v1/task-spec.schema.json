{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hlg:ai-contract:v1:task-spec",
  "title": "TaskSpec (V1)",
  "description": "Machine block of an approved SPEC-AI-NNN spec. Defines scope only; grants no production authority. Approval is established outside this document (ADR-AI-006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "spec_id",
    "title",
    "objective",
    "scope",
    "requirements",
    "acceptance_criteria",
    "constraints",
    "deterministic_checks",
    "semantic_evals",
    "declared_changes",
    "human_gates",
    "max_iterations"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "artifact_type": { "const": "TaskSpec" },
    "spec_id": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/SpecId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/ScopePath" }
        },
        "forbidden_paths": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/ScopePath" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "maxLength": 5, "pattern": "^R-[0-9]{2,3}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "maxLength": 6, "pattern": "^AC-[0-9]{2,3}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "text"],
        "properties": {
          "id": { "type": "string", "maxLength": 5, "pattern": "^C-[0-9]{2,3}$" },
          "category": { "enum": ["security", "privacy"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/CheckId" }
    },
    "semantic_evals": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eval_id", "description", "threshold"],
        "properties": {
          "eval_id": { "type": "string", "maxLength": 6, "pattern": "^EV-[0-9]{2,3}$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "declared_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "migration", "production_config"],
      "properties": {
        "package": { "type": "boolean" },
        "migration": { "type": "boolean" },
        "production_config": { "type": "boolean" }
      }
    },
    "human_gates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "type", "description"],
        "properties": {
          "gate_id": { "type": "string", "maxLength": 5, "pattern": "^HG-[0-9]{2}$" },
          "type": { "enum": ["package_change", "migration", "production", "custom"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 10 }
  }
}
