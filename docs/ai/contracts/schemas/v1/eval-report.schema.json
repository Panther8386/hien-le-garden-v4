{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hlg:ai-contract:v1:eval-report",
  "title": "EvalReport (V1)",
  "description": "Deterministic and semantic AI evaluation results in separate arrays with disjoint vocabularies. No overall verdict and no human acceptance; aggregation and approvals are handled elsewhere (ADR-AI-005, ADR-AI-006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "spec_id",
    "run_id",
    "created_at",
    "producer",
    "source_commit",
    "base_commit",
    "deterministic",
    "semantic_ai"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "artifact_type": { "const": "EvalReport" },
    "spec_id": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/SpecId" },
    "run_id": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/RunId" },
    "created_at": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/Timestamp" },
    "producer": {
      "$ref": "urn:hlg:ai-contract:v1:common#/$defs/Producer",
      "type": "object",
      "additionalProperties": false,
      "properties": { "kind": { "const": "ci" }, "name": true }
    },
    "source_commit": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/Sha" },
    "base_commit": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/Sha" },
    "deterministic": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "result", "evidence"],
        "properties": {
          "check_id": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/CheckId" },
          "result": { "enum": ["PASS", "FAIL", "ERROR", "SKIPPED"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/EvidenceRef" }
          }
        }
      }
    },
    "semantic_ai": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eval_id", "metric", "threshold", "score", "result", "model", "evidence"],
        "properties": {
          "eval_id": { "type": "string", "maxLength": 6, "pattern": "^EV-[0-9]{2,3}$" },
          "metric": { "type": "string", "maxLength": 60, "pattern": "^[a-z][a-z0-9_]{0,59}$" },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "score": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
          "result": { "enum": ["MEETS_THRESHOLD", "BELOW_THRESHOLD", "EVAL_ERROR"] },
          "model": { "type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
          "evidence": {
            "type": "array",
            "maxItems": 5,
            "items": { "$ref": "urn:hlg:ai-contract:v1:common#/$defs/EvidenceRef" }
          }
        }
      }
    }
  }
}
